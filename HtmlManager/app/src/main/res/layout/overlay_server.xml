<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮窗：卡片态（地址 + 状态点）和小球态（贴边收起）叠在同一层，切换时只翻可见性。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 卡片态：贴边拖动松手后会切成小球，点小球再展开 -->
    <LinearLayout
        android:id="@+id/overlay_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_panel"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/overlay_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_overlay_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/overlay_title"
                android:textColor="@color/overlay_panel_text_secondary"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/overlay_close"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/overlay_close_desc"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:src="@drawable/ic_overlay_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/overlay_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:maxWidth="220dp"
            android:maxLines="1"
            android:textColor="@color/overlay_panel_text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 小球态：只剩一颗绿点，不挡内容；点一下展开 -->
    <FrameLayout
        android:id="@+id/overlay_bubble"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_overlay_bubble"
        android:contentDescription="@string/overlay_expand_desc"
        android:visibility="gone">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_overlay_dot" />
    </FrameLayout>
</FrameLayout>
