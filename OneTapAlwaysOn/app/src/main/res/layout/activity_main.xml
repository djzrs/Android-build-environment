<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchAlwaysOn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/tvColorLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/float_ball_color"
        android:textSize="16sp"
        android:textColor="?android:attr/textColorSecondary" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/colorDot0"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="8dp" />

        <View
            android:id="@+id/colorDot1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="8dp" />

        <View
            android:id="@+id/colorDot2"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="8dp" />

        <View
            android:id="@+id/colorDot3"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="8dp" />

        <View
            android:id="@+id/colorDot4"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="8dp" />

    </LinearLayout>

</LinearLayout>